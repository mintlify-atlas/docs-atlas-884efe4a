  "keyFeatures": [
    "YAML-defined DAG workflows with parallel execution and conditional branching",
    "Git worktree isolation — every workflow run gets its own isolated environment",
    "Multi-platform support: Web UI, CLI, Slack, Telegram, GitHub, Discord",
    "Multi-provider AI: Claude Code, Codex, and Pi (20+ LLM backends)",
    "Built-in workflow library: 19 bundled workflows for common dev tasks",
    "Loop nodes for iterative AI execution until completion criteria are met",
    "Human-in-the-loop approval gates for review and feedback",
    "Bash, script (TypeScript/Python), and MCP server integration nodes",
    "SQLite (default) or PostgreSQL database with zero-setup operation",
    "Structured output enforcement and per-node tool restrictions"
  ],
  "publicApiSurface": [
    "archon workflow list",
    "archon workflow run <name> [message]",
    "archon workflow status",
    "archon workflow resume <run-id>",
    "archon workflow abandon <run-id>",
    "archon workflow approve <run-id> [comment]",
    "archon workflow reject <run-id> [--reason]",
    "archon workflow cleanup [days]",
    "archon isolation list",
    "archon isolation cleanup [days] [--merged] [--include-closed]",
    "archon complete <branch>",
    "archon validate workflows [name]",
    "archon validate commands [name]",
    "archon setup",
    "archon doctor",
    "archon serve [--port]",
    "archon skill install [path]",
    "archon version",
    "GET /api/workflows",
    "POST /api/workflows/runs/{runId}/resume",
    "POST /api/workflows/runs/{runId}/abandon",
    "GET /api/codebases",
    "POST /api/codebases",
    "GET /api/health",
    "GET /api/openapi.json"
  ]
